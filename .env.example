# This file is a tracked template. Copy it to .env and put real values there.
# Never put real keys in this file.
# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Plans: "fake" (offline) or "openai" (OpenAI-compatible endpoint)
LLM_BACKEND=fake
