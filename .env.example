# This file is a tracked template. Copy it to .env and put real values there.
# Never put real keys in this file.
# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Plans: "fake" (offline) or "openai" (OpenAI-compatible endpoint)
LLM_BACKEND=fake
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT=30
# LLM_MAX_TOKENS=1200
# Reasoning models (for example Gemini 3 Flash) spend output tokens on thinking,
# so give them a larger budget, e.g. LLM_MAX_TOKENS=8192 and LLM_TIMEOUT=120.
# LLM_RETRIES=2
# LLM_RETRY_DELAY=1.5

# Resources: "fake" (offline) or "real" (YouTube, Open Library, Wikipedia, Google Books, GitHub)
RESOURCE_BACKEND=fake
# YOUTUBE_API_KEY=
# GITHUB_TOKEN=
# FETCH_TIMEOUT=10

# Background plan generation. Set to 1 and run a worker in a second process:
#   python manage.py run_plan_worker
# Leave this at 0 for a single-process local setup; generation then runs in the request.
PLAN_JOBS_ENABLED=0
# PLAN_JOB_POLL_SECONDS=2
# PLAN_JOB_WORKER_HINT_SECONDS=10
# PLAN_JOB_STALE_MINUTES=30

# Cost controls. 0 means unlimited. Set a limit when using a paid LLM provider.
PLAN_DAILY_LIMIT=0
# Record token usage per model/day in the admin and usage_report command.
LLM_USAGE_TRACKING=1

# Production only. Uncomment and fill these in on the server; never put real secrets
# in this tracked template.
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=learnloop.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://learnloop.example.com
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_TRUST_X_FORWARDED_PROTO=1
# DJANGO_LOG_LEVEL=INFO
# DB_ENGINE=postgres
# DB_NAME=learnloop
# DB_USER=learnloop
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
